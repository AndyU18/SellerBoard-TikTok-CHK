# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Bases de datos locales y secretos (nunca commitear credenciales de plataformas)
*.db
*.sqlite3
.env
.env.*
!.env.example

# Node
node_modules/
dist/

# Tokens de plataformas (rotan; nunca commitear)
tts_tokens*.json
tokens*.json
# Respaldo (.bak), bloqueo (.lock) y temporales (.tmp) de la renovación atómica de tokens
tokens*.json.*

# Copias de seguridad generadas por `python -m app.backup`
backups/

# Variables públicas de docker compose (las VITE_ del frontend)
/.env

# TikTok orgánico (tokens OAuth del dueño; rotan, nunca commitear)
tiktok_organic_tokens*.json

# Respaldo/bloqueo/temporal de los tokens del vendedor y del orgánico (la renovación atómica los crea junto al archivo)
tts_tokens*.json.*
tiktok_organic_tokens*.json.*
