# Plantilla de variables del backend. Copia este archivo a `.env` y descomenta SOLO lo que uses.
# `.env` está en .gitignore: nunca lo subas ni lo pegues en un chat. Aquí no va ningún valor real.
#
# Todo está comentado a propósito: una variable vacía (p. ej. `WMT_CLIENT_ID=`) cuenta como
# "configurada" y la sincronización automática intentaría conectarse con credenciales vacías.

# ----------------------------------------------------------------------------- Base de datos
# Sin esta variable se usa SQLite local (backend/chk_local.db), ideal para desarrollo y pruebas.
# Para Supabase: la cadena del "Session pooler" (puerto 5432) de Project Settings > Database.
# CHK_DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/postgres

# ----------------------------------------------------------------------------- Autenticación
# URL del proyecto de Supabase (la usa el backend para validar los tokens de sesión).
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Solo para probar la API sin login (http://127.0.0.1:8000/docs). NUNCA en producción.
# CHK_AUTH_REQUIRED=false

# ----------------------------------------------------------------------------- Aplicación
# Zona horaria de los reportes por hora (Horas pico). Las horas se guardan en UTC.
# CHK_REPORT_TIMEZONE=America/New_York
# CHK_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ----------------------------------------------------------------------------- Sincronización automática
# Viene activa. Solo sincroniza las plataformas que tengan credenciales abajo (solo lectura).
# CHK_AUTO_SYNC=false
# CHK_AUTO_SYNC_INTERVAL_MINUTES=360
# CHK_AUTO_SYNC_DAYS=14

# ----------------------------------------------------------------------------- TikTok Shop (API de vendedor)
# TTS_APP_KEY=
# TTS_APP_SECRET=
# TTS_ACCESS_TOKEN=
# TTS_REFRESH_TOKEN=
# TTS_ACCESS_TOKEN_EXPIRE_IN=0
# TTS_SHOP_CIPHER=
# Los tokens renovados se guardan aquí (también ignorado por git):
# TTS_TOKENS_FILE=tts_tokens.json

# ----------------------------------------------------------------------------- Walmart Marketplace
# WMT_CLIENT_ID=
# WMT_CLIENT_SECRET=

# ----------------------------------------------------------------------------- Redo (costo de etiquetas)
# REDO_STORE_ID=
# REDO_API_KEY=
