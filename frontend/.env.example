# Plantilla de frontend/.env.local. NO uses `cp` a ciegas (sobrescribe tu archivo): ejecuta
# `.\scripts\setup-env.ps1`, que lo crea solo si no existe y guarda un respaldo .bak.
# La publishable key es pública; NUNCA pongas aquí la secret key ni ninguna contraseña (todo lo de este archivo
# viaja dentro del JavaScript del navegador).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
